mixin button(options)
  -
    const {
      variant = 'filled',
      type = 'button',
      disabled = false,
      size = '',
      fullWidth = false,
      icon = '',
      text = '',
      href = '',
      ariaLabel = '',
      className = ''
    } = options || {};

    const classes = [
      'btn',
      `btn--${variant}`,
      size && `btn--${size}`,
      fullWidth && 'btn--full-width',
      !text && icon && 'btn--icon-only',
      className
    ].filter(Boolean).join(' ');

    const hasIcon = !!icon;
    const hasText = !!text;
    const label = ariaLabel || text;

  if href
    a(
      class=classes
      href=href
      role='button'
      aria-label=label
    )
      if hasIcon
        span.btn__icon !{icon}
      if hasText
        span.btn__text #{text}
      if block
        block
  else
    button(
      class=classes
      type=type
      disabled=disabled
      aria-label=label
    )
      if hasIcon
        span.btn__icon !{icon}
      if hasText
        span.btn__text #{text}
      if block
        block
