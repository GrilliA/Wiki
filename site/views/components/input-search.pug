mixin inputSearch(options)
  -
    const {
      placeholder = 'Search...',
      name = 'search',
      disabled = false,
      size = '',
      fullWidth = false,
      className = '',
      value = ''
    } = options || {};

    const classes = [
      'input-search',
      size && `input-search--${size}`,
      fullWidth && 'input-search--full-width',
      className
    ].filter(Boolean).join(' ');

  div(class=classes)
    span.input-search__icon 🔍
    input.input-search__field(
      type='search'
      name=name
      placeholder=placeholder
      disabled=disabled
      value=value
      autocomplete='off'
      aria-label=placeholder
    )
    button.input-search__clear(
      type='button'
      aria-label='Clear search'
    ) ✕
