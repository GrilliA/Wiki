//- Table of Contents Mobile Dropdown Mixin
//- Usage: +tocMobile(items, options)
//- items: Array of { title, href, id }
//- options: { title?: string }

mixin tocMobile(items, options)
  - options = options || {}
  - var title = options.title || 'Contents'
  nav.toc-mobile(aria-label="Table of contents")
    button.toc-mobile__trigger.js-toc-trigger(type="button" aria-expanded="false" aria-controls="toc-panel")
      span.toc-mobile__trigger-icon
        i(data-feather="list" height="24" width="24")
    .toc-mobile__panel#toc-panel
      .toc-mobile__header
        h2.toc-mobile__title
          span.toc-mobile__title-icon
            i(data-feather="list" height="16" width="16")
          span= title
        button.toc-mobile__close.js-toc-close(type="button" aria-label="Close")
          i(data-feather="x" height="18" width="18")
      .toc-mobile__content
        ul.toc-mobile__list
          each item in items
            li.toc-mobile__item
              a.toc-mobile__link.js-toc-link(href=item.href)
                span.toc-mobile__link-icon
                  i(data-feather="hash" height="14" width="14")
                span= item.title
