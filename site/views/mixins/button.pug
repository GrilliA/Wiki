mixin btn(options)
  - const { variant = 'filled', size, text, icon, id, class: extraClass, type="button" } = options || {}
  - const classList = ['btn', `btn--${variant}`]

  if size
    - classList.push(`btn--${size}`)

  if extraClass
    - classList.push(extraClass)

  button(class=classList.join(' ') id=id type=type)
    if icon
      - const {height = 16, width=16, name} = icon || {}
      i.btn__icon(data-feather=name height=height width=width)
    if text
      span.btn__text= text
