include components/button.pug

doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Button Component Demo
    link(rel='stylesheet' href='/dist/styles.css')
    style.
      body {
        font-family: system-ui, -apple-system, sans-serif;
        padding: 2rem;
        background-color: var(--color-surface);
        color: var(--neutral-900);
      }
      .demo-section {
        margin-bottom: 3rem;
      }
      .demo-section h2 {
        font-size: var(--text-xl);
        margin-bottom: 1rem;
        color: var(--neutral-900);
      }
      .demo-section h3 {
        font-size: var(--text-lg);
        margin: 1.5rem 0 0.75rem;
        color: var(--neutral-700);
      }
      .button-group {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1rem;
      }
      .container {
        max-width: var(--container-xl);
        margin: 0 auto;
      }

  body
    .container
      h1 Button Component Demo

      .demo-section
        h2 Filled Variant
        
        h3 Default State
        .button-group
          +button({ variant: 'filled', text: 'Button' })
          +button({ variant: 'filled', text: 'With Icon', icon: '➜' })
          +button({ variant: 'filled', icon: '★' })
        
        h3 Hover State (hover over buttons)
        .button-group
          +button({ variant: 'filled', text: 'Hover Me' })
        
        h3 Focus State (tab to focus)
        .button-group
          +button({ variant: 'filled', text: 'Focus Me' })
        
        h3 Active State (click and hold)
        .button-group
          +button({ variant: 'filled', text: 'Click Me' })
        
        h3 Disabled State
        .button-group
          +button({ variant: 'filled', text: 'Disabled', disabled: true })
          +button({ variant: 'filled', text: 'Disabled', icon: '➜', disabled: true })
          +button({ variant: 'filled', icon: '★', disabled: true })

      .demo-section
        h2 Outline Variant
        
        h3 Default State
        .button-group
          +button({ variant: 'outline', text: 'Button' })
          +button({ variant: 'outline', text: 'With Icon', icon: '➜' })
          +button({ variant: 'outline', icon: '★' })
        
        h3 Hover State (hover over buttons)
        .button-group
          +button({ variant: 'outline', text: 'Hover Me' })
        
        h3 Focus State (tab to focus)
        .button-group
          +button({ variant: 'outline', text: 'Focus Me' })
        
        h3 Active State (click and hold)
        .button-group
          +button({ variant: 'outline', text: 'Click Me' })
        
        h3 Disabled State
        .button-group
          +button({ variant: 'outline', text: 'Disabled', disabled: true })
          +button({ variant: 'outline', text: 'Disabled', icon: '➜', disabled: true })
          +button({ variant: 'outline', icon: '★', disabled: true })

      .demo-section
        h2 Transparent Variant
        
        h3 Default State
        .button-group
          +button({ variant: 'transparent', text: 'Button' })
          +button({ variant: 'transparent', text: 'With Icon', icon: '➜' })
          +button({ variant: 'transparent', icon: '★' })
        
        h3 Hover State (hover over buttons)
        .button-group
          +button({ variant: 'transparent', text: 'Hover Me' })
        
        h3 Focus State (tab to focus)
        .button-group
          +button({ variant: 'transparent', text: 'Focus Me' })
        
        h3 Active State (click and hold)
        .button-group
          +button({ variant: 'transparent', text: 'Click Me' })
        
        h3 Disabled State
        .button-group
          +button({ variant: 'transparent', text: 'Disabled', disabled: true })
          +button({ variant: 'transparent', text: 'Disabled', icon: '➜', disabled: true })
          +button({ variant: 'transparent', icon: '★', disabled: true })

      .demo-section
        h2 Button Sizes
        
        h3 Small
        .button-group
          +button({ variant: 'filled', text: 'Small Button', size: 'sm' })
          +button({ variant: 'outline', text: 'Small Button', size: 'sm' })
          +button({ variant: 'transparent', text: 'Small Button', size: 'sm' })
        
        h3 Default
        .button-group
          +button({ variant: 'filled', text: 'Default Button' })
          +button({ variant: 'outline', text: 'Default Button' })
          +button({ variant: 'transparent', text: 'Default Button' })
        
        h3 Large
        .button-group
          +button({ variant: 'filled', text: 'Large Button', size: 'lg' })
          +button({ variant: 'outline', text: 'Large Button', size: 'lg' })
          +button({ variant: 'transparent', text: 'Large Button', size: 'lg' })

      .demo-section
        h2 Icon-Only Buttons
        .button-group
          +button({ variant: 'filled', icon: '★', size: 'sm' })
          +button({ variant: 'filled', icon: '★' })
          +button({ variant: 'filled', icon: '★', size: 'lg' })
        .button-group
          +button({ variant: 'outline', icon: '➜', size: 'sm' })
          +button({ variant: 'outline', icon: '➜' })
          +button({ variant: 'outline', icon: '➜', size: 'lg' })
        .button-group
          +button({ variant: 'transparent', icon: '✓', size: 'sm' })
          +button({ variant: 'transparent', icon: '✓' })
          +button({ variant: 'transparent', icon: '✓', size: 'lg' })

      .demo-section
        h2 Full Width Buttons
        +button({ variant: 'filled', text: 'Full Width Button', fullWidth: true })
        br
        br
        +button({ variant: 'outline', text: 'Full Width Button', fullWidth: true })
        br
        br
        +button({ variant: 'transparent', text: 'Full Width Button', fullWidth: true })

      .demo-section
        h2 Link Buttons
        .button-group
          +button({ variant: 'filled', text: 'Link Button', href: '#' })
          +button({ variant: 'outline', text: 'Link Button', href: '#' })
          +button({ variant: 'transparent', text: 'Link Button', href: '#' })
