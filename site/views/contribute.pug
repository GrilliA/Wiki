extends layout.pug

block title
  | Contribute - Wiki Server
block content
  +pageTitle('Why to contribute')
  section.section
    .container
      .section-content
        .section-paragraph
          | Dance has a history <br/>
          | Learn it! <br/>
          | Share it! <br/>
  include includes/gridLines.pug

  section.section
    +sectionTitle('Why?')
    .container
      .section-content
        p We grow through shared knowledge. 
        p Every dancer, teacher, researcher and culture-keeper has something valuable to share. 
  include includes/gridLines.pug

  section.section
    +sectionTitle('Your contribution matters')
    .container
      .section-content
        p Helping with documenting stories, pioneers and history that risk to be forgotten.
        p Your knowledge helps others understand their movement with depth and respect
  include includes/gridLines.pug

  section.section
    +sectionTitle('What you can contribute')
    .container
      .section-content
        ol
          li Historical facts
          li Events and festivals
          li Cultural context
          li Blog posts and articles
  include includes/gridLines.pug

  section.section
    +sectionTitle('Our Commitment to You')
    .container
      .section-content
        ul
          li We review every contribution to ensure accuracy, respect and cultural integrity.
          li Together we build a space where dance history is honored and accessible
  include includes/gridLines.pug
      
