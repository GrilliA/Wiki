doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Component Library - Wiki Dance
    link(rel='stylesheet' href='/dist/styles.css')
    style.
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, sans-serif;
        background-color: var(--color-surface);
        color: var(--neutral-900);
        line-height: var(--leading-normal);
      }
      .layout {
        display: flex;
        min-height: 100vh;
      }
      .sidebar {
        width: 250px;
        background-color: var(--neutral-100);
        border-right: 1px solid var(--neutral-200);
        padding: 2rem 1.5rem;
        position: fixed;
        left: 0;
        top: 0;
        height: 100vh;
        overflow-y: auto;
      }
      .sidebar__title {
        font-size: var(--text-xl);
        font-weight: var(--font-bold);
        margin: 0 0 1.5rem 0;
        color: var(--neutral-900);
      }
      .sidebar__section {
        margin-bottom: 2rem;
      }
      .sidebar__section-title {
        font-size: var(--text-sm);
        font-weight: var(--font-semibold);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--neutral-600);
        margin: 0 0 0.75rem 0;
      }
      .sidebar__nav {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .sidebar__nav-item {
        margin-bottom: 0.25rem;
      }
      .sidebar__nav-link {
        display: block;
        padding: 0.5rem 0.75rem;
        color: var(--neutral-700);
        text-decoration: none;
        border-radius: var(--radius-md);
        transition: all 0.2s ease;
      }
      .sidebar__nav-link:hover {
        background-color: var(--neutral-200);
        color: var(--neutral-900);
      }
      .sidebar__nav-link.active {
        background-color: var(--color-primary-100);
        color: var(--color-primary-700);
        font-weight: var(--font-semibold);
      }
      .main-content {
        flex: 1;
        margin-left: 250px;
        padding: 2rem 3rem;
        max-width: 1400px;
      }
      .header {
        margin-bottom: 3rem;
        padding-bottom: 2rem;
        border-bottom: 2px solid var(--neutral-200);
      }
      .header__title {
        font-size: 2.5rem;
        font-weight: var(--font-bold);
        margin: 0 0 0.5rem 0;
        color: var(--neutral-900);
      }
      .header__subtitle {
        font-size: var(--text-lg);
        color: var(--neutral-600);
        margin: 0;
      }
      .section {
        margin-bottom: 4rem;
        scroll-margin-top: 2rem;
      }
      .section__title {
        font-size: 2rem;
        font-weight: var(--font-bold);
        margin: 0 0 1rem 0;
        color: var(--neutral-900);
      }
      .section__subtitle {
        font-size: var(--text-xl);
        font-weight: var(--font-semibold);
        margin: 2rem 0 1rem 0;
        color: var(--neutral-800);
      }
      .section__heading {
        font-size: var(--text-lg);
        font-weight: var(--font-semibold);
        margin: 1.5rem 0 0.75rem 0;
        color: var(--neutral-700);
      }
      .section__text {
        margin: 0 0 1rem 0;
        color: var(--neutral-700);
      }
      .demo-group {
        margin-bottom: 2rem;
      }
      .demo-group__title {
        font-size: var(--text-base);
        font-weight: var(--font-semibold);
        margin: 0 0 0.75rem 0;
        color: var(--neutral-800);
      }
      .demo-group__description {
        font-size: var(--text-sm);
        color: var(--neutral-600);
        margin: 0 0 1rem 0;
      }
      .demo-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 1.5rem;
        background-color: var(--neutral-50);
        border: 1px solid var(--neutral-200);
        border-radius: var(--radius-lg);
      }
      .code-block {
        background-color: var(--neutral-900);
        color: var(--neutral-100);
        padding: 1.5rem;
        border-radius: var(--radius-lg);
        overflow-x: auto;
        font-family: 'Courier New', monospace;
        font-size: var(--text-sm);
        line-height: var(--leading-relaxed);
        margin: 1rem 0;
      }
      .code-inline {
        background-color: var(--neutral-200);
        color: var(--color-primary-700);
        padding: 0.125rem 0.375rem;
        border-radius: var(--radius-sm);
        font-family: 'Courier New', monospace;
        font-size: 0.9em;
      }
      .table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
      }
      .table th,
      .table td {
        text-align: left;
        padding: 0.75rem 1rem;
        border: 1px solid var(--neutral-200);
      }
      .table th {
        background-color: var(--neutral-100);
        font-weight: var(--font-semibold);
        color: var(--neutral-900);
      }
      .table td {
        background-color: var(--color-surface);
        color: var(--neutral-700);
      }
      .badge {
        display: inline-block;
        padding: 0.25rem 0.5rem;
        background-color: var(--color-primary-100);
        color: var(--color-primary-700);
        border-radius: var(--radius);
        font-size: var(--text-xs);
        font-weight: var(--font-semibold);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .divider {
        height: 1px;
        background-color: var(--neutral-200);
        margin: 2rem 0;
      }

  body
    include components/button.pug

    .layout
      aside.sidebar
        h1.sidebar__title Component Library

        .sidebar__section
          h2.sidebar__section-title Getting Started
          ul.sidebar__nav
            li.sidebar__nav-item
              a.sidebar__nav-link(href='#overview') Overview
            li.sidebar__nav-item
              a.sidebar__nav-link(href='#installation') Installation

        .sidebar__section
          h2.sidebar__section-title Components
          ul.sidebar__nav
            li.sidebar__nav-item
              a.sidebar__nav-link.active(href='#button') Button

      main.main-content
        .header
          h1.header__title Component Library
          p.header__subtitle A comprehensive collection of reusable UI components for Wiki Dance

        section#overview.section
          h2.section__title Overview
          p.section__text This component library provides a set of accessible, customizable, and well-documented UI components built with Pug templates and SCSS. All components follow BEM naming conventions and use CSS custom properties from the global design system.

        section#installation.section
          h2.section__title Installation
          p.section__text To use any component in your Pug templates, include the component mixin:
          .code-block.
            include components/button.pug

            +button({ variant: 'filled', text: 'Click Me' })

        .divider

        section#button.section
          h2.section__title Button Component
          p.section__text A flexible and accessible button component with multiple variants, sizes, and states.

          .demo-group
            .badge Features
            p.section__text 3 variants (filled, outline, transparent) • All states (hover, focus, active, disabled) • Icons, text, or both • 3 sizes • Fully accessible

          h3.section__subtitle Interactive Demo

          .demo-group
            h4.demo-group__title Filled Variant
            p.demo-group__description Primary action button with solid background
            .demo-buttons
              +button({ variant: 'filled', text: 'Button' })
              +button({ variant: 'filled', text: 'With Icon', icon: '➜' })
              +button({ variant: 'filled', icon: '★', ariaLabel: 'Star' })
              +button({ variant: 'filled', text: 'Disabled', disabled: true })

          .demo-group
            h4.demo-group__title Outline Variant
            p.demo-group__description Secondary action with border and transparent background
            .demo-buttons
              +button({ variant: 'outline', text: 'Button' })
              +button({ variant: 'outline', text: 'With Icon', icon: '➜' })
              +button({ variant: 'outline', icon: '★', ariaLabel: 'Star' })
              +button({ variant: 'outline', text: 'Disabled', disabled: true })

          .demo-group
            h4.demo-group__title Transparent Variant
            p.demo-group__description Tertiary/ghost button with no border or background
            .demo-buttons
              +button({ variant: 'transparent', text: 'Button' })
              +button({ variant: 'transparent', text: 'With Icon', icon: '➜' })
              +button({ variant: 'transparent', icon: '★', ariaLabel: 'Star' })
              +button({ variant: 'transparent', text: 'Disabled', disabled: true })

          .demo-group
            h4.demo-group__title Button Sizes
            p.demo-group__description Small, default, and large sizes available
            .demo-buttons
              +button({ variant: 'filled', text: 'Small', size: 'sm' })
              +button({ variant: 'filled', text: 'Default' })
              +button({ variant: 'filled', text: 'Large', size: 'lg' })

          .demo-group
            h4.demo-group__title Icon-Only Buttons
            p.demo-group__description Perfect for toolbar actions and close buttons
            .demo-buttons
              +button({ variant: 'filled', icon: '★', size: 'sm', ariaLabel: 'Favorite' })
              +button({ variant: 'outline', icon: '➜', ariaLabel: 'Next' })
              +button({ variant: 'transparent', icon: '×', size: 'lg', ariaLabel: 'Close' })

          .demo-group
            h4.demo-group__title Full Width Buttons
            .demo-buttons(style='display: block;')
              +button({ variant: 'filled', text: 'Full Width Button', fullWidth: true })
              br
              +button({ variant: 'outline', text: 'Full Width Button', fullWidth: true })

          .demo-group
            h4.demo-group__title Link Buttons
            p.demo-group__description Links styled as buttons using the href property
            .demo-buttons
              +button({ variant: 'filled', text: 'Link Button', href: '#button' })
              +button({ variant: 'outline', text: 'Documentation', href: '#api' })

          h3.section__subtitle#api API Reference

          p.section__text All button options are passed as a single object to the mixin:

          table.table
            thead
              tr
                th Property
                th Type
                th Default
                th Description
            tbody
              tr
                td
                  code.code-inline variant
                td string
                td
                  code.code-inline 'filled'
                td Button style: 'filled', 'outline', or 'transparent'
              tr
                td
                  code.code-inline type
                td string
                td
                  code.code-inline 'button'
                td HTML button type: 'button', 'submit', or 'reset'
              tr
                td
                  code.code-inline disabled
                td boolean
                td
                  code.code-inline false
                td Whether the button is disabled
              tr
                td
                  code.code-inline size
                td string
                td
                  code.code-inline ''
                td Button size: 'sm', '' (default), or 'lg'
              tr
                td
                  code.code-inline fullWidth
                td boolean
                td
                  code.code-inline false
                td Whether button should take full width
              tr
                td
                  code.code-inline icon
                td string
                td
                  code.code-inline ''
                td HTML/text to display as icon
              tr
                td
                  code.code-inline text
                td string
                td
                  code.code-inline ''
                td Button text content
              tr
                td
                  code.code-inline href
                td string
                td
                  code.code-inline ''
                td If provided, renders as &lt;a&gt; instead of &lt;button&gt;
              tr
                td
                  code.code-inline ariaLabel
                td string
                td
                  code.code-inline ''
                td Accessibility label (defaults to text value)
              tr
                td
                  code.code-inline className
                td string
                td
                  code.code-inline ''
                td Additional CSS classes

          h3.section__subtitle Usage Examples

          h4.section__heading Basic Usage
          .code-block.
            // Text only button
            +button({ variant: 'filled', text: 'Click Me' })

            // Button with icon and text
            +button({ variant: 'outline', text: 'Save', icon: '💾' })

            // Icon only button
            +button({ variant: 'transparent', icon: '×', ariaLabel: 'Close' })

          h4.section__heading All Variants
          .code-block.
            // Primary action
            +button({ variant: 'filled', text: 'Submit' })

            // Secondary action
            +button({ variant: 'outline', text: 'Cancel' })

            // Tertiary/ghost action
            +button({ variant: 'transparent', text: 'Learn More' })

          h4.section__heading Sizes
          .code-block.
            +button({ size: 'sm', text: 'Small' })
            +button({ text: 'Default' })
            +button({ size: 'lg', text: 'Large' })

          h4.section__heading States
          .code-block.
            // Disabled button
            +button({ text: 'Disabled', disabled: true })

            // Submit button
            +button({ type: 'submit', text: 'Submit Form' })

          h4.section__heading Link as Button
          .code-block.
            +button({ 
              variant: 'outline', 
              text: 'View Details', 
              href: '/details' 
            })

          h4.section__heading Full Width
          .code-block.
            +button({ 
              variant: 'filled', 
              text: 'Continue', 
              fullWidth: true 
            })

          h3.section__subtitle Direct HTML Usage

          p.section__text If not using Pug, apply classes directly to your HTML:

          .code-block.
            &lt;!-- Filled button with icon and text --&gt;
            &lt;button class="btn btn--filled"&gt;
              &lt;span class="btn__icon"&gt;💾&lt;/span&gt;
              &lt;span class="btn__text"&gt;Save&lt;/span&gt;
            &lt;/button&gt;

            &lt;!-- Outline button, small size --&gt;
            &lt;button class="btn btn--outline btn--sm"&gt;
              &lt;span class="btn__text"&gt;Cancel&lt;/span&gt;
            &lt;/button&gt;

            &lt;!-- Icon only, transparent --&gt;
            &lt;button class="btn btn--transparent btn--icon-only" 
                    aria-label="Close"&gt;
              &lt;span class="btn__icon"&gt;×&lt;/span&gt;
            &lt;/button&gt;

          h3.section__subtitle CSS Classes

          p.section__text The button component uses BEM naming convention:

          table.table
            thead
              tr
                th Class
                th Description
            tbody
              tr
                td
                  code.code-inline .btn
                td Base button styles
              tr
                td
                  code.code-inline .btn--filled
                td Solid background variant (primary)
              tr
                td
                  code.code-inline .btn--outline
                td Border with transparent background
              tr
                td
                  code.code-inline .btn--transparent
                td No border or background (ghost)
              tr
                td
                  code.code-inline .btn--sm
                td Small button size
              tr
                td
                  code.code-inline .btn--lg
                td Large button size
              tr
                td
                  code.code-inline .btn--icon-only
                td Removes text padding for icon-only buttons
              tr
                td
                  code.code-inline .btn--full-width
                td Makes button full width
              tr
                td
                  code.code-inline .btn__icon
                td Icon wrapper element
              tr
                td
                  code.code-inline .btn__text
                td Text wrapper element

          h3.section__subtitle Accessibility

          p.section__text The button component follows accessibility best practices:

          ul
            li All buttons have proper semantic HTML (
              code.code-inline &lt;button&gt;
              |  or 
              code.code-inline &lt;a role="button"&gt;
              | )
            li Icon-only buttons should always include an 
              code.code-inline ariaLabel
            li Focus states are clearly visible with focus rings
            li Disabled buttons cannot be interacted with
            li Keyboard navigation fully supported (Tab, Enter, Space)
            li Links styled as buttons include 
              code.code-inline role="button"

          h3.section__subtitle Customization

          p.section__text Override CSS variables to customize button appearance:

          .code-block.
            .my-custom-button {
              --color-primary-600: #your-color;
              --color-primary-700: #your-hover-color;
              --radius-md: 0.5rem;
            }

    script.
      // Simple active navigation
      document.addEventListener('DOMContentLoaded', () => {
        const links = document.querySelectorAll('.sidebar__nav-link');
        links.forEach(link => {
          link.addEventListener('click', (e) => {
            links.forEach(l => l.classList.remove('active'));
            e.target.classList.add('active');
          });
        });
      });
