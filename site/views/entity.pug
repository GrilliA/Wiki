          ul.data-list
            li.data-list__item
              span.data-list__label Creation Date
              span.data-list__value 1990-01-01
            li.data-list__item
              span.data-list__label Organizer
              span.data-list__value Oriabure Trust
            li.data-list__item
              span.data-list__label Type of event
              span.data-list__value House, Hip-Hop
            li.data-list__item
              span.data-list__label Location
              span.data-list__value Italy
            li.data-list__item
              span.data-list__label Frequency
