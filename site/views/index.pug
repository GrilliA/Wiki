doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    if env === 'development'
      script(type="module" src="/@vite/client")
    else
      link(rel="stylesheet" href="/dist/styles.css")
    title Welcome to Wiki Server
    if env === 'development'
      script(type="module" src="/dist/index.ts")
    else
      script(src="/dist/bundle.js")
  body
    include includes/navigation.pug

    main
      .top-section
        .container
          .top-section__wrapper
            .top-section__text Are you a contributor? then
            button.btn.btn--transparent.btn--sm.js-home-login Log in
              i.btn__icon(data-feather="log-in" height="16" width="16")
      .hero-upper
        .container
          .hero-upper-grid-lines 
            .line
            .line
            .line
            .line
            .line
            .line
            .line
            .line

      .hero-title
        .container
          .hero-title__text Search engine made by dancer community, for the dance community!

      .hero-upper
        .container
          .hero-upper-grid-lines 
            .line
            .line
            .line
            .line
            .line
            .line
            .line
            .line
      .hero-search
        .container
          .hero-search__input.input-search
            input.input-search__field.input-search__lg(placeholder="Search for dance moves, styles, or anything related to dance..." enterkeyhint="search")
            i.input-search__icon(data-feather="search" height="24" width="24")
            i.input-search__clear(data-feather="x" height="16" width="16")
    
    footer
      .footer footer


