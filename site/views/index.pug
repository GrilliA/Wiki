extends layout.pug

block title
  | Welcome to Wiki Server

block content
  include includes/gridLines.pug
  .hero-title
    .container
      .hero-title__text Search engine made by dancer community, for the dance community!
  .hero-search
    .container
      .hero-search__input
        input.hero-search__input-field(placeholder="Search for dance moves, styles, or anything related to dance..." enterkeyhint="search")
        i.hero-search__input-icon(data-feather="search" height="24" width="24")
        i.hero-search__input-clear(data-feather="x" height="16" width="16")
  include includes/gridLines.pug

  .section
    +sectionTitle('Sponsored by')
    .container
      .sponsors__wrapper
        .sponsors__list
          .sponsors__item
            a.sponsor(href="https://www.mike.com" target="_blank")
              img.sponsor__logo(src="/images/mike.avif" alt="Mike's Logo")
  include includes/gridLines.pug

  section.blog
    +sectionTitle('Latest from the Community')
    .container
      .section-content.blog__wrapper
        each post in blog 
          article.blog-card
            .blog-card__image
              img(src=post.image alt="Blog Post Image")
            .blog-card__body
              .blog-card__tags
                each tag in post.tags
                  +badge({text: tag, variant: 'filled', size: 'sm'})
              +typography({ variant: 'title', text: post.title })
              +typography({ variant: 'body', text: post.body })
              .blog-card__footer
                +typography({ variant: 'caption',  color: 'dimmed',text: post.author })
                +typography({ variant: 'caption', color: 'dimmed', text: new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })})
