doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    if env === 'development'
      script(type="module" src="/@vite/client")
    else
      link(rel="stylesheet" href="/dist/styles.css")
    title Welcome to Wiki Server
    if env === 'development'
      script(type="module" src="/dist/index.ts")
    else
      script(src="/dist/bundle.js")
  body
    include includes/navigation.pug

    main
      .top-section
        .container
          .top-section__wrapper
            .top-section__text Are you a contributor? then
            button.btn.btn--transparent.btn--sm.js-home-login Log in
              i.btn__icon(data-feather="log-in" height="16" width="16")
      .hero-upper
        .container
          .hero-upper-grid-lines 
            .line
            .line
            .line
            .line
            .line
            .line
            .line
            .line

      .hero-title
        .container
          .hero-title__text Search engine made by dancer community, for the dance community!

      .hero-upper
        .container
          .hero-upper-grid-lines 
            .line
            .line
            .line
            .line
            .line
            .line
            .line
            .line
      .hero-search
        .container
          .hero-search__input
            input.hero-search__input-field(placeholder="Search for dance moves, styles, or anything related to dance..." enterkeyhint="search")
            i.hero-search__input-icon(data-feather="search" height="24" width="24")
            i.hero-search__input-clear(data-feather="x" height="16" width="16")
      .sponsors
        .container
          .sponsors__wrapper
            .sponsors__title Our Sponsors:
            .sponsors__list
              .sponsors__item
                a.sponsor(href="https://www.mike.com" target="_blank")
                  img.sponsor__logo(src="/images/mike.avif" alt="Mike's Logo")
    
      .menu-social.border-bottom
        .container
          ul.menu-icons.border-right.border-left
            li: a(href="#"): i(data-feather="facebook" height="4em" width="4em")
            li: a(href="#"): i(data-feather="twitter" height="4em" width="4em")
            li: a(href="#"): i(data-feather="instagram" height="4em" width="4em")
            li: a(href="#"): i(data-feather="linkedin" height="4em" width="4em")

      .menu-terms.border-bottom
        .container
          ul.terms-list.border-right.border-left
            li: a.terms-policy(href="#") Privacy Policy
            li: a.terms-service(href="#") Terms of Service
            li: a.terms-help(href="#") Help Center
            li: a.terms-cookie(href="#") Cookie Policy

      .menu-footer
        .container
          .copyright © 2024 Wiki Server. All rights reserved.
