model Option {
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now()) @updatedAt
  deletedAt        DateTime?
  id               Int         @id @default(autoincrement())
  groupId          Int
  group            Group       @relation(fields: [groupId], references: [id])
  index            Int         @default(0)
  value            Json // value contains the value validated by the schema of the group
  users            User[]
  clients          Client[]
  cropRegime       Crop[]      @relation("crop_regime")
  cropGroup        Crop[]      @relation("crop_group")
  cropType         Crop[]      @relation("crop")
  typeOfTreatment  Recipe[]    @relation("treatment_type")
  treatmentPhase   Recipe[]    @relation("treatment_phase")
  inventoryStorage Inventory[] @relation("product_option")
  inventoryProduct Inventory[] @relation("storage_option")
}
