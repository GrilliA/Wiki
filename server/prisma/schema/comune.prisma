model Comune {
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  deletedAt    DateTime?
  id           Int       @id @default(autoincrement())
  belfioreCode String    @unique
  istatCode    String    @unique
  name         String
  isCapital    Boolean
  areaKmQ      String
  latitude     String
  longitude    String
  provinceCode String
  province     Province  @relation(fields: [provinceCode], references: [code])
  cap          Cap[]
  clients      Client[]
}
