model Region {
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  deletedAt       DateTime?
  id              Int        @id @default(autoincrement())
  name            String
  geoDistribution String
  type            String
  code            String     @unique
  areaKmQ         String
  provinces       Province[]
  clients         Client[]
}
