model Like {
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  id        Int       @id @default(autoincrement())
  thread    Thread?   @relation(fields: [threadId], references: [id])
  threadId  Int?
  isLiked   Boolean
  user      User      @relation(fields: [userId], references: [id])
  userId    String
}
