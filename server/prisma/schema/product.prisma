model Product {
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  deletedAt      DateTime?
  id             Int       @id @default(autoincrement())
  isFertilizer   Boolean
  name           String?
  fertilizerName String?
  quantity       Float
  unit           String
  recipe         Recipe    @relation(fields: [recipeId], references: [id])
  recipeId       Int
}
