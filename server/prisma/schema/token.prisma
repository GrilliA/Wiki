model Token {
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  id        Int       @id @default(autoincrement())
  type      Int
  expiresAt DateTime
  user      User?     @relation(fields: [userId], references: [id])
  code      String    @unique @default(uuid())
  userId    String?
}
