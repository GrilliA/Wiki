{
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "sourceMap": false,
    "strict": false,
    "lib": ["ESNext", "DOM"],
    "module": "CommonJS",
    "target": "ESNext",
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "types/*.d.ts"],
  "exclude": ["node_modules", "views"]
}
