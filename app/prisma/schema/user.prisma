model User {
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  name        String?
  surname     String?
  phoneNumber String?
  permissions String    @default("")
  status      Int?
  role        Int?
  facilityId  Int?
}
